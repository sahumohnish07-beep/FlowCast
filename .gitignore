# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# Datasets and large raw data (rule: never commit large raw datasets >50MB)
data/raw/*
!data/raw/.gitkeep
data/processed/*.parquet
data/processed/*.csv
*.h5
*.hdf5
*.zip
*.tar.gz
*.7z

# Model binaries and checkpoints (development checkpoints and large weights excluded)
models/*.pkl
models/*.pth
models/*.bin
models/*.onnx
models/*_checkpoint*.pt
!models/.gitkeep

# Tracked runtime production model artifacts (compact, ~3MB total for cloud deployment)
!models/best_baseline_model.joblib
!models/best_traffic_gru.pt
!models/congestion_classifier.joblib
!models/travel_time_model.joblib
!models/accident_risk_classifier.joblib
!models/scaler.joblib

# Unit test / coverage reports
.coverage
.coverage.*
.pytest_cache/
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Operating System files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

